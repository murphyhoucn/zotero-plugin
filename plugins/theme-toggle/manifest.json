{
  "manifest_version": 2,
  "name": "Theme Toggle",
  "version": "1.1.3",
  "description": "Toggle Zotero's native light/dark color scheme from a toolbar button, the Tools menu, or a keyboard shortcut (Ctrl/Cmd+Shift+D).",
  "author": "murphy",
  "homepage_url": "https://github.com/murphyhoucn/zotero-plugin",
  "icons": {
    "48": "chrome/content/icons/logo.svg",
    "96": "chrome/content/icons/logo.svg"
  },
  "applications": {
    "zotero": {
      "id": "theme-toggle@local",
      "update_url": "https://raw.githubusercontent.com/murphyhoucn/zotero-plugin/main/plugins/theme-toggle/update.json",
      "strict_min_version": "8.0",
      "strict_max_version": "10.*"
    }
  }
}
